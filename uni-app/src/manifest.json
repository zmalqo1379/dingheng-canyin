{
  "name": "鼎恒餐饮",
  "appid": "",
  "description": "鼎恒餐饮扫码点餐 + 管理后台（微信小程序）",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "postcss": true,
      "minified": true
      // 2026-09-19 移除 lazyload(按需注入)：它会在部分版本的开发者工具里引发
      // __pageframe__ 500 / 页面逻辑不执行，商城页「永远加载中」的元凶之一。
      // 11 个页面的小程序吃不到这点优化收益，不值得冒这个险。
    },
    "usingComponents": true,
    "darkmode": true,
    "themeLocation": "theme.json",
    "permission": {
      "scope.userLocation": {
        "desc": "你的位置信息将用于门店选址与门店推荐（在地图上标注门店位置）"
      }
    },
    "requiredPrivateInfos": [
      "chooseLocation",
      "getLocation"
    ],
    "lazyCodeLoading": "requiredComponents"
  },
  "h5": {
    "title": "鼎恒餐饮",
    "router": {
      "mode": "hash"
    },
    "devServer": {
      "port": 5173,
      "proxy": {
        "/api": {
          "target": "http://localhost:3000",
          "changeOrigin": true,
          "secure": false
        }
      }
    }
  },
  "vueVersion": "3"
}
