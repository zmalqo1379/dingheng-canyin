# ============ 鼎恒餐饮 环境变量示例 ============
# 复制为 .env 后按实际部署环境填写；.env 不要提交到仓库。

# MongoDB 连接串
MONGODB_URI=mongodb://127.0.0.1:27017/dingheng_canyin

# 服务端口
# PORT=3000

# ---------- 开发者后台账号（不配置则启动时不创建任何默认账号） ----------
# 仅当两项都填写时，服务启动才会创建/复用该开发者账号
DEV_ADMIN_USER=
DEV_ADMIN_PASSWORD=

# ---------- 平台客服联系方式（对外展示，务必填写真实号码后再生效） ----------
# 客服电话（如 400 电话申请下来后填在这里）
SERVICE_PHONE=
# 客服邮箱
SUPPORT_EMAIL=

# ---------- 以下仅一次性脚本（scripts/ 目录）使用，生产环境可不配置 ----------
# scripts/seedProducts.js 创建示例供应商「鼎恒农贸」时使用的密码
SEED_SUPPLIER_PASSWORD=
# scripts/verify_sort_deliver.js 使用的测试商家账号
TEST_MERCHANT_PHONE=
TEST_MERCHANT_PASSWORD=
# scripts/verify_weigh_e2e.js 注册临时测试供应商使用的密码
TEST_SUPPLIER_PASSWORD=
